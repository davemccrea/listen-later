# Cloudflare tunnel token for this stack's cloudflared.
# In the tunnel, add a Public Hostname: listen-later.mccrea.link -> http://caddy:80
TUNNEL_TOKEN=your-cloudflare-tunnel-token

# The playlist to watch (make it Public or Unlisted so yt-dlp can read it).
PLAYLIST_URL=https://www.youtube.com/playlist?list=PLxxxxxxxxxxxxxxxxxxxx

# Public base URL Caddy is served at (the feed lands at <this>/feed.xml).
PODCAST_BASE_URL=https://listen-later.mccrea.link

PODCAST_TITLE=Listen Later
PODCAST_DESCRIPTION=YouTube videos I saved to listen to instead of watch.
PODCAST_AUTHOR=David

# How often to check the playlist, in seconds (default 900 = 15 min).
POLL_INTERVAL=900
