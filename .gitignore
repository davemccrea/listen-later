# Secrets — commit .env.example instead
**/.env
**/docker-compose.env
tsdproxy/config/.authkey

# Python bytecode caches
**/__pycache__/
*.pyc

# Service config dirs that are entirely runtime state
bookstack/config/
sonarr/config/
radarr/config/
prowlarr/config/
bazarr/config/
navidrome/config/
audiobookshelf/config/
calibre-web-automated/config/
qbittorrent/config/

# Service config files that contain credentials or runtime state
sabnzbd/config/sabnzbd.ini
sabnzbd/config/sabnzbd.ini.bak
sabnzbd/config/admin/
sabnzbd/config/logs/
seerr/config/db/
seerr/config/logs/
seerr/config/settings.json
seerr/config/settings.old.json
seerr/config/anime-list.xml
seerr/config/cache/

# Homepage logs (config yaml files are worth keeping)
homepage/config/logs/

# Tailscale sidecar state (node keys and credentials)
**/tailscale/state/

# Caddy runtime: issued certs, OCSP staples, autosave config
caddy/data/
caddy/config/

# Service data directories
beszel/data/
beszel/beszel_agent_data/
tsidp/data/
mousehole/data/
freshrss/data/

# listen-later: downloaded audio + generated feed + yt-dlp state (runtime data)
listen-later/data/

# Bulk data and generated files — too large and noisy for git
immich/library/
immich/postgres/
immich/model-cache/
bookstack/mariadb/
plex/config/
shared/
audiobookshelf/metadata/
calibre-web-automated/calibre-library/
qbittorrent/downloads/
papra/app-data/
papra/ingestion/
