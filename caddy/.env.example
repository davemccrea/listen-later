# Cloudflare API token with Zone:DNS:Edit on the mccrea.link zone (DNS-01).
CF_API_TOKEN=

# ACME account email (used for Let's Encrypt notifications).
ACME_EMAIL=mail@dmccrea.me

# ---- oauth2-proxy (forward-auth) — only needed once the guarded services are
# ---- enabled. See README "Forward-auth back-channel" before relying on these.
OIDC_ISSUER_URL=https://tsidp.tailfab2f.ts.net
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
# Generate: openssl rand -base64 32 | tr -d '\n'
OAUTH2_COOKIE_SECRET=
