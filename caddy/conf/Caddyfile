# =============================================================================
# Caddy ingress for *.mccrea.link  (private; resolved only via AdGuard on the
# tailnet). Single wildcard cert obtained with the ACME DNS-01 challenge against
# Cloudflare, so individual hostnames never appear in CT logs.
#
# Backends are reached by Docker container name over the external `proxy`
# bridge. A site block for a service that hasn't been migrated onto `proxy` yet
# simply returns 502 until it joins — it does not stop Caddy from starting, and
# does not affect the wildcard cert. Migration is therefore: attach the service
# to `proxy`, set any host/base-URL config, done — no edit needed here.
# =============================================================================
{
	email {env.ACME_EMAIL}
}

# Wildcard TLS via Cloudflare DNS-01. One cert covers every host below.
*.mccrea.link {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	# --- throwaway host to verify DNS + wildcard TLS independent of backends ---
	@whoami host whoami.mccrea.link
	handle @whoami {
		respond "caddy ok"
	}

	# ---------------------------------------------------------------------------
	# No edge auth (tailnet trust is sufficient; native apps handle their own).
	# ---------------------------------------------------------------------------
	@immich host immich.mccrea.link
	handle @immich {
		reverse_proxy immich_server:2283
	}

	@jellyfin host jellyfin.mccrea.link
	handle @jellyfin {
		reverse_proxy jellyfin:8096
	}

	@homepage host homepage.mccrea.link
	handle @homepage {
		reverse_proxy homepage:3000
	}

	@paperless host paperless.mccrea.link
	handle @paperless {
		reverse_proxy paperless:8000
	}

	@navidrome host navidrome.mccrea.link
	handle @navidrome {
		reverse_proxy navidrome:4533
	}

	@beszel host beszel.mccrea.link
	handle @beszel {
		reverse_proxy beszel:8090
	}

	# Servarr + downloader. No edge auth (tailnet trust).
	@sonarr host sonarr.mccrea.link
	handle @sonarr {
		reverse_proxy sonarr:8989
	}

	@radarr host radarr.mccrea.link
	handle @radarr {
		reverse_proxy radarr:7878
	}

	@prowlarr host prowlarr.mccrea.link
	handle @prowlarr {
		reverse_proxy prowlarr:9696
	}

	# sabnzbd keeps url_base=/sabnzbd; send the bare root there for convenience.
	@sabnzbd host sabnzbd.mccrea.link
	handle @sabnzbd {
		redir / /sabnzbd/
		reverse_proxy sabnzbd:8080
	}

	# bookstack is currently served PUBLICLY at wiki.mccrea.link via the
	# cloudflared tunnel and has no Tailscale sidecar. Decide public-vs-tailnet
	# before adding it here; left out intentionally.

	# Anything not matched above on *.mccrea.link
	handle {
		respond "no such service" 404
	}
}
